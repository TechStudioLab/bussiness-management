{
  "name": "techstudiolab-business",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787 --local-upstream localhost:8787",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply techstudiolab-business --local",
    "db:migrate:remote": "wrangler d1 migrations apply techstudiolab-business --remote",
    "deploy": "npm run build && wrangler d1 migrations apply techstudiolab-business --remote && wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.53.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
